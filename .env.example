# DzidzaAI environment variables (example)
# Copy this to .env and fill values before running docker-compose

# App
NODE_ENV=production
PORT=5000
CLIENT_URL=https://your-frontend-domain.example

# MongoDB
MONGODB_URI=mongodb://mongo:27017/dzidzaai

# Redis
REDIS_URL=redis://redis:6379

# Qdrant / Vector DB (if used)
VECTOR_BACKEND=qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=dzidzaai_document_chunks

# Cookie & Auth
ACCESS_TOKEN_SECRET=change_this_access_secret
REFRESH_TOKEN_SECRET=change_this_refresh_secret
COOKIE_SAME_SITE=lax

# Email provider (Sendgrid, Mailgun, etc.)
EMAIL_PROVIDER=sendgrid
EMAIL_API_KEY=your_sendgrid_api_key
EMAIL_FROM=no-reply@your-domain.example

# AI provider keys (set at least one)
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Object storage (S3 compatible)
S3_BUCKET=dzidzaai-uploads
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional: OAuth / SSO
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Optional: monitoring / sentry
SENTRY_DSN=
