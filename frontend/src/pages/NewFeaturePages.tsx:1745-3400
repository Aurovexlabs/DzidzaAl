// 4. AI ESSAY GRADER
// ═══════════════════════════════════════════════════════════════════════════════
export const EssayGraderPage: React.FC = () => {
  const { user } = useAuthStore();
  const [view, setView] = useState<"form" | "grading" | "result" | "history">("form");
  const [grades, setGrades] = useState<EssayGrade[]>([]);
  const [activeGrade, setActiveGrade] = useState<EssayGrade | null>(null);
  
  const [form, setForm] = useState({
    question: "",
    answer: "",
    subject: "",
    maxMarks: 20,
  });
  
  const [submitting, setSubmitting] = useState(false);
  const gradeColors: Record<string, string> = {
    A: "var(--color-secondary)",
    B: "var(--color-primary)",
    C: "var(--color-secondary-light)",
    D: "var(--color-accent)",
    E: "var(--color-accent)",
    U: "var(--danger)",
  };

  useEffect(() => {
    essayApi
      .getAll()
      .then((r) => setGrades((r.data as any).data?.grades || []))
      .catch(() => {});
  }, []);

  const submitEssay = async () => {
    if (!form.question || !form.answer) { toast.error("Question and response required"); return; }
    if (form.answer.trim().split(" ").length < 30) { toast.error("Analytical depth too low (min 30 words)"); return; }
    setSubmitting(true); setView("grading");
    try {
      const r = await essayApi.grade(form);
      const grade = (r.data as any).data?.grade;
      setActiveGrade(grade);
      setGrades((prev) => [grade, ...prev]);
      setView("result");
    } catch {
      toast.error("Grading sequence failed");
      setView("form");
    } finally {
      setSubmitting(false);
    }
  };

  return (
    <div className="max-w-6xl mx-auto space-y-8 animate-fade-in pb-12">
      <div className="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <h2 className="text-3xl font-bold font-serif text-ink mb-2">AI Paper Examiner</h2>
          <p className="text-sm text-ink3 font-medium">Professional ZIMSEC-style assessment of long-form academic responses</p>
        </div>
        <div className="flex gap-2 p-1 bg-surface2 rounded-2xl border border-border2">
          <button onClick={() => setView("form")} className={clsx("px-5 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all", view === 'form' || view === 'result' ? 'bg-surface text-primary shadow-lg border border-border2' : 'text-ink3 hover:text-ink')}>Active Lab</button>
          <button onClick={() => setView("history")} className={clsx("px-5 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest transition-all", view === 'history' ? 'bg-surface text-primary shadow-lg border border-border2' : 'text-ink3 hover:text-ink')}>Grade Archive ({grades.length})</button>
        </div>
      </div>

      {view === "form" && (
        <div className="grid grid-cols-1 lg:grid-cols-[1fr_350px] gap-8 items-start">
          <Card className="p-8 shadow-2xl border-border2">
            <div className="space-y-8">
              <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div className="space-y-1.5">
                   <label className="text-[10px] font-black text-ink3 uppercase tracking-[0.2em] px-1">Syllabus Hub</label>
                   <Input placeholder="e.g. Advanced Sociology" value={form.subject} onChange={e => setForm({...form, subject: e.target.value})} />
                </div>
                <div className="space-y-1.5">
                   <label className="text-[10px] font-black text-ink3 uppercase tracking-[0.2em] px-1">Mark Capacity</label>
                   <select className="input text-sm font-bold bg-bg" value={form.maxMarks} onChange={e => setForm({...form, maxMarks: +e.target.value})}>
                     {[10, 15, 20, 25, 30].map(m => <option key={m} value={m}>{m} Points</option>)}
                   </select>
                </div>
              </div>

              <div className="space-y-1.5">
                <label className="text-[10px] font-black text-ink3 uppercase tracking-[0.2em] px-1">Formal Question</label>
                <textarea 
                  className="input min-h-[100px] text-sm font-bold" 
                  placeholder="Paste the examination question verbatim..." 
                  value={form.question}
                  onChange={e => setForm({...form, question: e.target.value})}
                />
              </div>

              <div className="space-y-1.5">
                <div className="flex justify-between items-center px-1 mb-2">
                   <label className="text-[10px] font-black text-ink3 uppercase tracking-[0.2em]">Academic Response</label>
                   <Badge variant="blue" className="text-[9px]">{form.answer.trim().split(/\s+/).filter(Boolean).length} Words</Badge>
                </div>
                <textarea 
                  className="w-full bg-bg border-2 border-border2 rounded-2xl p-8 text-lg font-medium focus:ring-8 focus:ring-primary/5 focus:border-primary outline-none transition-all shadow-inner min-h-[500px] leading-loose" 
                  placeholder="Synthesize your comprehensive response..." 
                  value={form.answer}
                  onChange={e => setForm({...form, answer: e.target.value})}
                />
              </div>

              <Button size="lg" className="w-full h-16 shadow-2xl text-lg gap-3" onClick={submitEssay} loading={submitting}>
                 <Sparkles size={24} /> Execute AI Assessment Protocol
              </Button>
            </div>
          </Card>

          <aside className="space-y-6">
             <Card className="bg-bg-light/50 dark:bg-bg-dark/50 border-dashed border-2">
                <h4 className="text-[10px] font-black text-ink3 uppercase tracking-[0.2em] mb-6 flex items-center gap-2">
                   <ShieldCheck size={14} /> Evaluation Matrix
                </h4>
                <div className="space-y-4">
                   {[
                     { l: "Knowledge", p: "50%", d: "Accuracy and depth of specific syllabus content." },
                     { l: "Synthesis", p: "25%", d: "Structural integrity and argumentative flow." },
                     { l: "Precision", p: "25%", d: "Academic register, grammar, and technical vocabulary." },
                   ].map(c => (
                     <div key={c.l} className="p-4 rounded-xl bg-surface border border-border2 shadow-soft">
                        <div className="flex justify-between items-center mb-1">
                           <p className="text-xs font-black text-ink">{c.l}</p>
                           <span className="text-[10px] font-black text-primary">{c.p}</span>
                        </div>
                        <p className="text-[10px] font-medium text-ink3 leading-relaxed">{c.d}</p>
                     </div>
                   ))}
                </div>
             </Card>

             <Card className="bg-primary/[0.03] border-primary/10">
                <p className="text-xs font-bold text-ink2 leading-relaxed italic">
                  "AI examiners are calibrated against ZIMSEC 2026 standards for <strong>{user?.educationLevel}</strong>. Grading is diagnostic; use results to target revision."
                </p>
             </Card>
          </aside>
        </div>
      )}

      {view === "grading" && (
        <div className="py-32 flex flex-col items-center gap-8">
           <div className="relative">
             <Spinner size={64} className="text-primary" />
             <div className="absolute inset-0 flex items-center justify-center">
                <PenTool size={28} className="text-primary animate-bounce" />
             </div>
           </div>
           <div className="text-center space-y-2">
              <h3 className="text-2xl font-black font-serif text-ink">Analyzing Academic Synthesis</h3>
              <p className="text-xs font-black text-ink3 uppercase tracking-[0.3em] animate-pulse">Running semantic scan · Cross-referencing mark scheme · Projecting grade</p>
           </div>
        </div>
      )}

      {view === "result" && activeGrade && (
        <div className="space-y-8 animate-in slide-in-from-bottom-8 duration-700">
           <div className="grid grid-cols-1 lg:grid-cols-3 gap-6">
              <Card className="text-center p-8 border-2" style={{ borderColor: `${gradeColors[activeGrade.grade]}30` }}>
                 <div className="w-20 h-20 rounded-3xl mx-auto flex items-center justify-center text-white mb-4 shadow-2xl" style={{ backgroundColor: gradeColors[activeGrade.grade] }}>
                    <span className="text-4xl font-black font-serif">{activeGrade.grade}</span>
                 </div>
                 <p className="text-[10px] font-black text-ink3 uppercase tracking-[0.2em]">Syllabus Grade</p>
              </Card>
              <Card className="text-center p-8 border-border2">
                 <h4 className="text-4xl font-black font-serif text-ink mb-1 tracking-tighter">
                   {activeGrade.earnedMarks}<span className="text-lg opacity-20">/{activeGrade.maxMarks}</span>
                 </h4>
                 <p className="text-[10px] font-black text-ink3 uppercase tracking-[0.2em]">Raw Score Matrix</p>
              </Card>
              <Card className="text-center p-8 border-border2">
                 <h4 className="text-4xl font-black font-serif text-ink mb-1 tracking-tighter">{activeGrade.wordCount}</h4>
                 <p className="text-[10px] font-black text-ink3 uppercase tracking-[0.2em]">Lexical Volume</p>
              </Card>
           </div>

           <div className="grid grid-cols-1 lg:grid-cols-[1fr_400px] gap-8 items-start">
              <div className="space-y-6">
                 <Card className="p-10 shadow-soft">
                    <h3 className="text-lg font-black font-serif text-ink mb-10 flex items-center gap-3">
                       <Target size={20} className="text-primary" /> Evaluation Breakdown
                    </h3>
                    <div className="space-y-10">
                       {activeGrade.criteria.map(c => (
                         <div key={c.name} className="space-y-4">
                            <div className="flex justify-between items-end">
                               <div>
                                  <h4 className="text-sm font-black text-ink uppercase tracking-wider">{c.name}</h4>
                                  <p className="text-[10px] font-bold text-ink3 uppercase tracking-widest">{c.maxMarks} Points Max</p>
                               </div>
                               <span className="text-2xl font-black text-primary">{c.earnedMarks}</span>
                            </div>
                            <ProgressBar value={(c.earnedMarks/c.maxMarks)*100} className="!gap-1 h-2" color="var(--color-primary)" />
                            <p className="text-sm font-medium text-ink2 leading-relaxed bg-bg-light/50 dark:bg-bg-dark/50 p-4 rounded-xl border border-border2 italic">"{c.feedback}"</p>
                         </div>
                       ))}
                    </div>
                 </Card>

                 <Card className="bg-primary/[0.02] border-primary/10 p-10">
                    <h3 className="text-lg font-black font-serif text-ink mb-6">Strategic Summary</h3>
                    <p className="text-lg font-medium text-ink2 leading-loose">{activeGrade.overallFeedback}</p>
                 </Card>
              </div>

              <aside className="space-y-6">
                 <Card className="p-8 border-t-4 border-t-secondary">
                    <h4 className="text-sm font-black uppercase tracking-widest text-secondary flex items-center gap-2 mb-6">
                       <CheckCircle2 size={18} /> Proficiencies
                    </h4>
                    <div className="space-y-3">
                       {activeGrade.strengths.map((s, i) => (
                         <div key={i} className="p-4 rounded-xl bg-secondary/[0.03] border border-secondary/10 text-xs font-bold text-ink2 leading-relaxed">
                            {s}
                         </div>
                       ))}
                    </div>
                 </Card>

                 <Card className="p-8 border-t-4 border-t-warn">
                    <h4 className="text-sm font-black uppercase tracking-widest text-warn flex items-center gap-2 mb-6">
                       <TrendingUp size={18} /> Optimizations
                    </h4>
                    <div className="space-y-3">
                       {activeGrade.improvements.map((s, i) => (
                         <div key={i} className="p-4 rounded-xl bg-warn/[0.03] border border-warn/10 text-xs font-bold text-ink2 leading-relaxed">
                            {s}
                         </div>
                       ))}
                    </div>
                 </Card>

                 {activeGrade.modelAnswer && (
                   <Card className="p-8">
                      <h4 className="text-sm font-black uppercase tracking-widest text-primary flex items-center gap-2 mb-6">
                         <Volume2 size={18} /> Ideal Response
                      </h4>
                      <p className="text-[11px] font-medium text-ink3 leading-relaxed max-h-[300px] overflow-y-auto scrollbar-hidden">
                        {activeGrade.modelAnswer}
                      </p>
                      <Button variant="ghost" size="sm" className="w-full mt-6 border-t border-border2 rounded-none pt-4 text-[10px] font-black uppercase tracking-widest" onClick={() => { setForm({...form, answer: activeGrade.modelAnswer!}); setView('form'); }}>
                        Synthesize New Lab
                      </Button>
                   </Card>
                 )}
              </aside>
           </div>
        </div>
      )}

      {view === "history" && (
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
           {grades.length === 0 ? (
             <div className="col-span-full"><EmptyState icon={<FileText size={40} />} title="Archive Empty" description="Grade an essay to begin building your academic record." action={<Button onClick={() => setView('form')}>Initialize Lab</Button>} /></div>
           ) : (
             grades.map(g => (
               <Card key={g._id} hoverable onClick={() => { setActiveGrade(g); setView('result'); }} className="group">
                  <div className="flex items-center gap-5">
                     <div className="w-14 h-14 rounded-2xl flex items-center justify-center text-white font-black text-2xl shadow-lg shrink-0 group-hover:scale-110 transition-transform" style={{ backgroundColor: gradeColors[g.grade] || 'var(--color-primary)' }}>
                        {g.grade}
                     </div>
                     <div className="flex-1 min-w-0">
                        <h4 className="text-base font-bold text-ink truncate mb-1">{g.question}</h4>
                        <div className="flex items-center gap-4 text-[10px] font-black text-ink3 uppercase tracking-widest">
                           <span className="flex items-center gap-1.5"><Target size={12} /> {g.subject || 'Core'}</span>
                           <span>•</span>
                           <span className="flex items-center gap-1.5"><Activity size={12} /> {g.percentage}%</span>
                        </div>
                     </div>
                     <ChevronRight size={16} className="text-ink3 group-hover:text-primary transition-all" />
                  </div>
               </Card>
             ))
           )}
        </div>
      )}
    </div>
  );
};

