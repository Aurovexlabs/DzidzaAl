// 2. LEARNING PATH GENERATOR
// ═══════════════════════════════════════════════════════════════════════════════
export const LearningPathPage: React.FC = () => {
  const { user } = useAuthStore();
  const [paths, setPaths] = useState<LearningPath[]>([]);
  const [activePath, setActivePath] = useState<LearningPath | null>(null);
  const [generating, setGenerating] = useState(false);
  const [loading, setLoading] = useState(true);
  const [showForm, setShowForm] = useState(false);
  const [form, setForm] = useState({
    subject: "",
    targetExamDate: "",
    hoursPerDay: 2,
  });

  useEffect(() => {
    learningPathApi
      .getAll()
      .then((r) => setPaths((r.data as any).data?.paths || []))
      .catch(() => {})
      .finally(() => setLoading(false));
  }, []);

  const generate = async () => {
    if (!form.subject) { toast.error("Subject specification required"); return; }
    setGenerating(true);
    try {
      const r = await learningPathApi.generate(form);
      const path = (r.data as any).data?.path;
      setPaths((prev) => [path, ...prev.filter((p) => p.subject !== form.subject)]);
      setActivePath(path);
      setShowForm(false);
      toast.success("Academic roadmap synthesized.");
    } catch {
      toast.error("Roadmap generation failed");
    } finally {
      setGenerating(false);
    }
  };

  const completeMilestone = async (pathId: string, milestoneId: string) => {
    try {
      const r = await learningPathApi.completeMilestone(pathId, milestoneId);
      const updated = (r.data as any).data?.path;
      setPaths((prev) => prev.map((p) => (p._id === pathId ? updated : p)));
      if (activePath?._id === pathId) setActivePath(updated);
      toast.success("Objective secured. +50 XP");
    } catch {
      toast.error("Update failed");
    }
  };

  if (loading) return <div className="flex items-center justify-center min-h-[70vh]"><Spinner size={40} className="text-primary" /></div>;

  return (
    <div className="max-w-6xl mx-auto space-y-8 animate-fade-in pb-12">
      <div className="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <h2 className="text-3xl font-bold font-serif text-ink mb-2">Academic Roadmap</h2>
          <p className="text-sm text-ink3 font-medium">AI-synthesized learning paths toward exam mastery</p>
        </div>
        <Button onClick={() => setShowForm(true)} className="gap-2 shadow-lg">
          <Plus size={18} /> Initialize New Path
        </Button>
      </div>

      {showForm && (
        <div className="max-w-xl mx-auto">
          <Card className="relative overflow-hidden border-border2 shadow-2xl">
            <h3 className="text-xl font-bold font-serif text-ink mb-8 flex items-center gap-3">
              <Map size={24} className="text-primary" />
              Configure Learning Path
            </h3>
            <div className="space-y-6">
              <div>
                <label className="text-[10px] font-black text-ink3 uppercase tracking-[0.2em] mb-2 block">Syllabus Subject</label>
                <Input placeholder="e.g. Organic Chemistry" value={form.subject} onChange={(e) => setForm({...form, subject: e.target.value})} />
              </div>
              <div>
                <label className="text-[10px] font-black text-ink3 uppercase tracking-[0.2em] mb-2 block">Examination Date</label>
                <input type="date" className="input text-sm font-bold bg-bg" value={form.targetExamDate} onChange={(e) => setForm({...form, targetExamDate: e.target.value})} />
              </div>
              <div className="pt-4">
                <div className="flex justify-between items-center mb-2">
                  <label className="text-[10px] font-black text-ink3 uppercase tracking-[0.2em]">Operational Capacity</label>
                  <span className="text-sm font-bold text-primary">{form.hoursPerDay} Hours / Day</span>
                </div>
                <input type="range" min={1} max={8} className="w-full h-2 bg-surface2 rounded-lg appearance-none cursor-pointer accent-primary" value={form.hoursPerDay} onChange={(e) => setForm({...form, hoursPerDay: +e.target.value})} />
              </div>
              <div className="pt-8 flex gap-4">
                <Button className="flex-1 h-12 shadow-xl" onClick={generate} loading={generating}>Synthesize Path</Button>
                <Button variant="ghost" className="h-12" onClick={() => setShowForm(false)}>Abort</Button>
              </div>
            </div>
          </Card>
        </div>
      )}

      <div className="grid grid-cols-1 lg:grid-cols-[320px_1fr] gap-8 items-start">
        {/* Left: Path Directory */}
        <aside className="space-y-4 sticky top-24">
          <h4 className="text-[10px] font-black text-ink3 uppercase tracking-[0.2em] px-2 mb-4">Active Roadmaps</h4>
          {paths.length === 0 ? (
            <EmptyState icon={<Map size={32} />} title="Pathless" description="No active roadmaps found." />
          ) : (
            paths.map((path) => (
              <Card 
                key={path._id} 
                onClick={() => setActivePath(path)}
                className={clsx(
                  "p-5 cursor-pointer transition-all duration-300 group",
                  activePath?._id === path._id ? "ring-2 ring-primary bg-primary/[0.02] shadow-xl" : "hover:border-primary/30"
                )}
              >
                <h4 className="font-bold text-ink mb-1 group-hover:text-primary transition-colors">{path.subject}</h4>
                <p className="text-[10px] font-black text-ink3 uppercase tracking-widest mb-4">{path.milestones.length} Objectives · {path.totalEstimatedHours}H</p>
                <ProgressBar value={path.completionPercentage} className="!gap-1" color="var(--color-primary)" />
              </Card>
            ))
          )}
        </aside>

        {/* Right: Active Path Execution */}
        <main>
          {activePath ? (
            <div className="space-y-10 animate-in slide-in-from-right-4 duration-500">
               <section className="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-border2 pb-8">
                  <div>
                    <h3 className="text-2xl font-black font-serif text-ink tracking-tight mb-2">{activePath.title}</h3>
                    <p className="text-sm font-medium text-ink2 max-w-xl leading-relaxed">{activePath.description}</p>
                  </div>
                  <div className="flex gap-4">
                     <div className="text-center p-3 px-6 rounded-2xl bg-surface border border-border2 shadow-soft">
                        <p className="text-[9px] font-black text-ink3 uppercase tracking-[0.15em] mb-1">Status</p>
                        <p className="text-xl font-bold text-primary">{activePath.completionPercentage}%</p>
                     </div>
                  </div>
               </section>

               <div className="space-y-4">
                  {activePath.milestones.map((m, i) => {
                    const isCurrent = i === activePath.currentMilestoneIndex;
                    return (
                      <div key={m._id} className="flex gap-6 group relative">
                        {/* Timeline Logic */}
                        <div className="flex flex-col items-center shrink-0">
                           <div className={clsx(
                             "w-12 h-12 rounded-2xl flex items-center justify-center text-sm font-black transition-all duration-500 shadow-lg relative z-10",
                             m.isCompleted ? "bg-secondary text-white" : 
                             isCurrent ? "bg-primary text-white scale-110 ring-4 ring-primary/10" : "bg-surface2 text-ink3"
                           )}>
                             {m.isCompleted ? <CheckCircle2 size={20} /> : m.order}
                           </div>
                           {i < activePath.milestones.length - 1 && (
                             <div className={clsx(
                               "w-1 flex-1 my-2 rounded-full transition-colors duration-700",
                               m.isCompleted ? "bg-secondary" : "bg-border2"
                             )} />
                           )}
                        </div>

                        <Card className={clsx(
                          "flex-1 p-8 transition-all duration-500 relative overflow-hidden",
                          isCurrent && !m.isCompleted ? "border-primary/40 shadow-2xl bg-primary/[0.01]" : "opacity-80"
                        )}>
                           <div className="flex flex-col md:flex-row md:items-start justify-between gap-6 mb-6">
                              <div>
                                <h4 className="text-lg font-bold text-ink mb-1">{m.title}</h4>
                                <div className="flex items-center gap-4 text-[10px] font-black text-ink3 uppercase tracking-widest">
                                  <span className="flex items-center gap-1.5"><Clock size={12} /> {m.estimatedHours}H Workload</span>
                                  <span>•</span>
                                  <span className="flex items-center gap-1.5"><Target size={12} /> {m.masteryRequired}% Proficiency</span>
                                </div>
                              </div>
                              {isCurrent && !m.isCompleted && (
                                <Button size="sm" className="shadow-lg h-10 px-6 gap-2" onClick={() => completeMilestone(activePath._id, m._id)}>
                                  Mark Objective Secured <ChevronRight size={14} />
                                </Button>
                              )}
                              {m.isCompleted && <Badge variant="teal" className="font-black px-4 py-1.5 rounded-lg shadow-inner">Secured</Badge>}
                           </div>
                           
                           <p className="text-sm font-medium text-ink2 leading-relaxed mb-6 italic">{m.description}</p>
                           
                           {m.resources?.length > 0 && (
                             <div className="flex flex-wrap gap-2">
                               {m.resources.map((r, ri) => (
                                 <Badge key={ri} variant="blue" className="bg-primary/5 text-primary border border-primary/10 lowercase font-bold tracking-tight">#{r.description.replace(/\s+/g, '')}</Badge>
                               ))}
                             </div>
                           )}
                           
                           {isCurrent && !m.isCompleted && <div className="absolute right-0 top-0 w-24 h-24 bg-primary/[0.03] rounded-full -translate-y-1/2 translate-x-1/2 blur-2xl" />}
                        </Card>
                      </div>
                    );
                  })}
               </div>
            </div>
          ) : (
            <EmptyState icon={<BrainCircuit size={48} />} title="Awaiting Command" description="Select an operational roadmap from the directory to begin execution." />
          )}
        </main>
      </div>
    </div>
  );
};

// ═══════════════════════════════════════════════════════════════════════════════
// 3. POMODORO FOCUS MODE
// ═══════════════════════════════════════════════════════════════════════════════
type FocusPhase = "idle" | "work" | "break" | "long_break" | "reflection";

export const FocusModePage: React.FC = () => {
  const { user } = useAuthStore();
  const [phase, setPhase] = useState<FocusPhase>("idle");
  const [session, setSession] = useState<FocusSession | null>(null);
  const [timeLeft, setTimeLeft] = useState(0);
  const [pomodorosThisRound, setPomodorosThisRound] = useState(0);
  const [history, setHistory] = useState<any[]>([]);
  const [historyStats, setHistoryStats] = useState<any>(null);
  const [loading, setLoading] = useState(true);
  const [aiFeedback, setAiFeedback] = useState("");
  const [reflection, setReflection] = useState({ accomplishments: "", obstacles: "", rating: 5 });
  const timerRef = useRef<any>(null);
  
  const [form, setForm] = useState({
    subject: "",
    topic: "",
    goal: "",
    workMinutes: 25,
    breakMinutes: 5,
  });

  useEffect(() => {
    focusApi
      .getHistory()
      .then((r) => {
        setHistory((r.data as any).data?.sessions || []);
        setHistoryStats((r.data as any).data?.stats || {});
      })
      .catch(() => {})
      .finally(() => setLoading(false));
  }, []);

  const tick = useCallback(() => {
    setTimeLeft((t) => {
      if (t <= 1) {
        clearInterval(timerRef.current);
        phaseComplete();
        return 0;
      }
      return t - 1;
    });
  }, [phase, session, pomodorosThisRound]);

  useEffect(() => {
    if (phase === "work" || phase === "break" || phase === "long_break") {
      timerRef.current = setInterval(tick, 1000);
    }
    return () => clearInterval(timerRef.current);
  }, [phase, tick]);

  const phaseComplete = async () => {
    if (phase === "work" && session) {
      const newCount = pomodorosThisRound + 1;
      setPomodorosThisRound(newCount);
      await focusApi.pomodoroComplete(session._id, session.workMinutes);
      toast.success(`Module ${newCount} Secured.`);
      const isLongBreak = newCount % 4 === 0;
      setTimeLeft(isLongBreak ? 15 * 60 : session.breakMinutes * 60);
      setPhase(isLongBreak ? "long_break" : "break");
    } else if (phase === "break" || phase === "long_break") {
      if (session) await focusApi.breakComplete(session._id);
      setTimeLeft(form.workMinutes * 60);
      setPhase("work");
    }
  };

  const startSession = async () => {
    try {
      const r = await focusApi.start(form);
      const s = (r.data as any).data?.session;
      setSession(s);
      setTimeLeft(form.workMinutes * 60);
      setPomodorosThisRound(0);
      setPhase("work");
    } catch {
      toast.error("Initialization failure");
    }
  };

  const logDistraction = async () => {
    if (!session) return;
    await focusApi.logDistraction(session._id);
    toast("Focus Compromised: Distraction logged", { icon: "⚠️" });
  };

  const endSession = (abandoned = false) => {
    clearInterval(timerRef.current);
    setPhase("reflection");
    if (abandoned) toast("Session Aborted Early", { icon: "⚠️" });
  };

  const submitReflection = async () => {
    if (!session) return;
    try {
      const r = await focusApi.complete(session._id, { ...reflection, abandoned: phase !== "reflection" });
      const { feedback, focusScore, xpEarned } = (r.data as any).data;
      setAiFeedback(feedback);
      toast.success(`Protocol Finalized. Score: ${focusScore}/100 · +${xpEarned} XP`);
      setHistory((prev) => [(r.data as any).data.session, ...prev]);
      setSession(null); setPhase("idle"); setPomodorosThisRound(0);
    } catch {
      toast.error("Telemetry upload failed");
    }
  };

  const formatTime = (s: number) => {
    const m = Math.floor(s / 60);
    const sec = s % 60;
    return `${m.toString().padStart(2, '0')}:${sec.toString().padStart(2, '0')}`;
  };

  const phaseConfig = {
    work: { color: "var(--color-primary)", label: "Deep Work Phase", badge: "blue" },
    break: { color: "var(--color-secondary)", label: "Neural Recovery", badge: "teal" },
    long_break: { color: "var(--color-secondary-light)", label: "System Restoration", badge: "teal" },
    idle: { color: "var(--color-text-secondary)", label: "Awaiting Command", badge: "blue" },
    reflection: { color: "var(--color-accent)", label: "Analytical Review", badge: "amber" },
  };

  const currentConfig = phaseConfig[phase];
  const totalSeconds = phase === 'work' ? form.workMinutes * 60 : phase === 'long_break' ? 15 * 60 : form.breakMinutes * 60;
  const progress = totalSeconds ? ((totalSeconds - timeLeft) / totalSeconds) * 100 : 0;

  if (loading) return <div className="flex items-center justify-center min-h-[70vh]"><Spinner size={40} className="text-primary" /></div>;

  return (
    <div className="max-w-6xl mx-auto space-y-8 animate-fade-in pb-12">
      <div className="flex flex-col md:flex-row md:items-end justify-between gap-6">
        <div>
          <h2 className="text-3xl font-bold font-serif text-ink mb-2">Deep Focus Labs</h2>
          <p className="text-sm text-ink3 font-medium">Enhanced Pomodoro protocol with AI concentration diagnostics</p>
        </div>
        <div className="flex gap-2">
           <Badge variant="blue" className="gap-2"><Activity size={12} /> Biometric Sync Simulation</Badge>
        </div>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-[1fr_380px] gap-8 items-start">
        {/* Main Interface */}
        <div className="space-y-6">
           <Card className="p-12 flex flex-col items-center justify-center text-center shadow-2xl relative overflow-hidden">
              <div className="absolute inset-0 bg-gradient-to-b from-primary/[0.01] to-transparent pointer-events-none" />
              
              <div className="relative z-10 space-y-10 w-full max-w-md">
                 <div className="space-y-2">
                    <Badge variant={currentConfig.badge as any} className="font-black px-6 py-2 rounded-full tracking-[0.2em]">{currentConfig.label.toUpperCase()}</Badge>
                    <p className="text-[10px] font-black text-ink3 uppercase tracking-[0.3em]">{session?.subject || 'SYSTEM READY'}</p>
                 </div>

                 {/* Stunning Circular Timer */}
                 <div className="relative w-72 h-72 mx-auto flex items-center justify-center group">
                    <svg className="absolute inset-0 w-full h-full -rotate-90">
                      <circle cx="144" cy="144" r="132" fill="none" stroke="var(--surface2)" strokeWidth="12" />
                      <circle 
                        cx="144" cy="144" r="132" fill="none" 
                        stroke={currentConfig.color} strokeWidth="12" strokeLinecap="round"
                        strokeDasharray={2 * Math.PI * 132}
                        strokeDashoffset={2 * Math.PI * 132 * (1 - progress / 100)}
                        className="transition-all duration-1000 ease-linear shadow-lg"
                      />
                    </svg>
                    <div className="text-center space-y-1 relative z-10 transition-transform duration-500 group-hover:scale-110">
                       <h3 className="text-7xl font-black font-mono tracking-tighter text-ink">{formatTime(timeLeft)}</h3>
                       {session && <p className="text-xs font-black text-primary uppercase tracking-widest">Module {pomodorosThisRound + 1} ACTIVE</p>}
                    </div>
                    {/* Inner pulse effect */}
                    {phase === 'work' && <div className="absolute w-56 h-56 rounded-full bg-primary/[0.03] animate-ping pointer-events-none" />}
                 </div>

                 <div className="flex flex-col gap-4">
                    {phase === "idle" && (
                      <Button size="lg" className="w-full h-14 rounded-2xl shadow-xl gap-2 text-base" onClick={startSession}>
                        <Play size={20} /> Initialize Protocol
                      </Button>
                    )}
                    {(phase === "work" || phase === "break" || phase === "long_break") && (
                      <div className="grid grid-cols-2 gap-4">
                         {phase === "work" && (
                           <Button variant="outline" className="h-12 border-2 hover:bg-red-500/5 hover:text-red-500 hover:border-red-500 transition-all gap-2" onClick={logDistraction}>
                             <AlertTriangle size={18} /> Distraction logged
                           </Button>
                         )}
                         <Button variant="danger" className={clsx("h-12 shadow-lg", phase !== 'work' && 'col-span-2')} onClick={() => endSession(true)}>
                           Abort Session
                         </Button>
                      </div>
                    )}
                 </div>
              </div>

              {phase === "reflection" && (
                <div className="mt-12 w-full max-w-lg space-y-6 animate-in fade-in duration-700 text-left border-t border-border2 pt-10">
                   <h3 className="text-xl font-bold font-serif text-ink mb-2">Cognitive Post-Review</h3>
                   <div className="space-y-4">
                      <div className="space-y-1.5">
                        <label className="text-[10px] font-black text-ink3 uppercase tracking-widest">Achieved Milestones</label>
                        <textarea 
                          className="input min-h-[100px] text-sm" 
                          placeholder="What modules did you complete?" 
                          value={reflection.accomplishments}
                          onChange={e => setReflection({...reflection, accomplishments: e.target.value})}
                        />
                      </div>
                      <div className="space-y-1.5">
                        <label className="text-[10px] font-black text-ink3 uppercase tracking-widest">Obstruction Vectors</label>
                        <textarea 
                          className="input min-h-[80px] text-sm" 
                          placeholder="What compromised your focus?" 
                          value={reflection.obstacles}
                          onChange={e => setReflection({...reflection, obstacles: e.target.value})}
                        />
                      </div>
                      <div className="pt-2">
                        <div className="flex justify-between items-center mb-2">
                          <label className="text-[10px] font-black text-ink3 uppercase tracking-widest">Focus Quality Rating</label>
                          <span className="text-sm font-bold text-warn">{reflection.rating} / 5</span>
                        </div>
                        <input type="range" min={1} max={5} className="w-full accent-warn h-2 bg-surface2 rounded-lg" value={reflection.rating} onChange={e => setReflection({...reflection, rating: +e.target.value})} />
                      </div>
                      <Button size="lg" className="w-full shadow-2xl h-14" onClick={submitReflection}>Execute Analysis</Button>
                   </div>
                </div>
              )}
           </Card>

           {aiFeedback && (
             <Card className="bg-primary/[0.02] border-primary/20 p-8 shadow-xl animate-in slide-in-from-bottom-4">
                <div className="flex items-center gap-3 mb-4">
                   <div className="p-2 rounded-xl bg-primary text-white"><BrainCircuit size={18} /></div>
                   <h4 className="text-[10px] font-black text-primary uppercase tracking-[0.2em]">Diagnostic Intelligence Report</h4>
                </div>
                <p className="text-base font-serif italic text-ink leading-relaxed">"{aiFeedback}"</p>
             </Card>
           )}
        </div>

        {/* Sidebar Controls */}
        <aside className="space-y-6">
           {phase === "idle" && (
             <Card className="shadow-soft">
                <h4 className="text-[10px] font-black text-ink3 uppercase tracking-[0.2em] mb-6 border-b border-border2 pb-4">Lab Parameters</h4>
                <div className="space-y-5">
                   <div>
                     <label className="text-[10px] font-black text-ink3 uppercase tracking-widest mb-1.5 block">Target Subject</label>
                     <Input placeholder="e.g. Pure Mathematics" value={form.subject} onChange={e => setForm({...form, subject: e.target.value})} />
                   </div>
                   <div>
                     <label className="text-[10px] font-black text-ink3 uppercase tracking-widest mb-1.5 block">Mission Goal</label>
                     <textarea className="input text-xs font-bold min-h-[80px]" placeholder="Specific session objective..." value={form.goal} onChange={e => setForm({...form, goal: e.target.value})} />
                   </div>
                   <div className="grid grid-cols-2 gap-4">
                      <div className="space-y-1.5">
                        <label className="text-[9px] font-black text-ink3 uppercase">Focus Module</label>
                        <div className="relative">
                          <input type="number" className="input pr-12 text-sm font-black" value={form.workMinutes} onChange={e => setForm({...form, workMinutes: +e.target.value})} />
                          <span className="absolute right-4 top-1/2 -translate-y-1/2 text-[10px] font-bold opacity-30">MIN</span>
                        </div>
                      </div>
                      <div className="space-y-1.5">
                        <label className="text-[9px] font-black text-ink3 uppercase">Recovery</label>
                        <div className="relative">
                          <input type="number" className="input pr-12 text-sm font-black" value={form.breakMinutes} onChange={e => setForm({...form, breakMinutes: +e.target.value})} />
                          <span className="absolute right-4 top-1/2 -translate-y-1/2 text-[10px] font-bold opacity-30">MIN</span>
                        </div>
                      </div>
                   </div>
                </div>
             </Card>
           )}

           {historyStats?.totalSessions > 0 && (
             <Card className="bg-bg-light/50 dark:bg-bg-dark/50 border-dashed border-2">
                <h4 className="text-[10px] font-black text-ink3 uppercase tracking-[0.2em] mb-6">Historical Metrics</h4>
                <div className="grid grid-cols-2 gap-3">
                   {[
                     { label: "Modules", val: historyStats.totalPomodoros, icon: "🍅", color: "text-red-500" },
                     { label: "Hours", val: Math.round(historyStats.totalMinutes / 6), icon: "⏱", color: "text-primary" },
                     { label: "Accuracy", val: `${Math.round(historyStats.avgFocusScore || 0)}%`, icon: "🎯", color: "text-secondary" },
                     { label: "Sessions", val: historyStats.totalSessions, icon: "📅", color: "text-accent" },
                   ].map(stat => (
                     <div key={stat.label} className="p-4 rounded-2xl bg-surface border border-border2 shadow-soft text-center group hover:scale-[1.05] transition-all">
                        <div className={clsx("text-xl mb-1", stat.color)}>{stat.icon}</div>
                        <p className="text-xl font-black text-ink tracking-tighter leading-none mb-1">{stat.val}</p>
                        <p className="text-[9px] font-bold text-ink3 uppercase tracking-widest">{stat.label}</p>
                     </div>
                   ))}
                </div>
             </Card>
           )}

           <div className="space-y-2">
              <h4 className="text-[10px] font-black text-ink3 uppercase tracking-[0.2em] px-2 mb-4 mt-8">Recent Telemetry</h4>
              {history.slice(0, 4).map(s => (
                <div key={s._id} className="p-4 rounded-2xl bg-surface2/50 border border-border2 flex justify-between items-center group hover:bg-surface transition-all">
                   <div>
                     <p className="text-xs font-bold text-ink mb-0.5">{s.subject || "Open Mission"}</p>
                     <p className="text-[9px] font-bold text-ink3 uppercase tracking-widest">{s.pomodorosCompleted} Modules Secured</p>
                   </div>
                   <Badge variant={s.focusScore > 80 ? 'teal' : 'amber'} className="font-black text-[9px]">{s.focusScore}%</Badge>
                </div>
              ))}
           </div>
        </aside>
      </div>
    </div>
  );
};
