import { useNavigate } from "@tanstack/react-router";
import React, { useCallback, useEffect, useRef, useState } from "react";
import toast from "react-hot-toast";
import {
  Badge,
  Button,
  Card,
  EmptyState,
  ProgressBar,
  Spinner,
  StatCard,
  Input,
  TypingIndicator
} from "../components/ui";
import {
  essayApi,
  examApi,
  focusApi,
  learningPathApi,
  voiceApi,
} from "../services/apiServices";
import { useAuthStore } from "../store/authStore";
import type {
  EssayGrade,
  ExamQuestion,
  ExamSession,
  FocusSession,
  LearningPath,
} from "../types";
import { clsx } from "clsx";
import { 
  ClipboardList, 
  Timer, 
  Target, 
  CheckCircle2, 
  XCircle, 
  Sparkles, 
  Plus, 
  History, 
  BrainCircuit, 
  Map, 
  Clock, 
  ArrowRight, 
  ChevronRight, 
  Play, 
  Pause, 
  RotateCcw, 
  AlertTriangle,
  PenTool,
  Mic,
  MicOff,
  Volume2,
  FileText,
  Code,
  Terminal,
  Eraser,
  Square,
  Type,
  Undo,
  Redo,
  Download,
  Trash,
  Palette
} from "lucide-react";

// ═══════════════════════════════════════════════════════════════════════════════
// 1. AI EXAM SIMULATOR
// ═══════════════════════════════════════════════════════════════════════════════
export const ExamSimulatorPage: React.FC = () => {
  const { user } = useAuthStore();
  const navigate = useNavigate();
  const [view, setView] = useState<"list" | "generate" | "taking" | "results">("list");
  const [exams, setExams] = useState<ExamSession[]>([]);
  const [activeExam, setActiveExam] = useState<ExamSession | null>(null);
  const [loading, setLoading] = useState(true);
  const [generating, setGenerating] = useState(false);
  const [answers, setAnswers] = useState<Record<string, string>>({});
  const [qIndex, setQIndex] = useState(0);
  const [timeLeft, setTimeLeft] = useState(0);
  const [results, setResults] = useState<any>(null);
  const timerRef = useRef<any>(null);
  
  const [genForm, setGenForm] = useState({
    subject: "",
    year: new Date().getFullYear().toString(),
    paper: "Paper 1",
    totalMarks: 100,
    questionTypes: ["mcq", "short_answer", "essay"] as string[],
  });

  useEffect(() => {
    examApi
      .getAll()
      .then((r) => setExams((r.data as any).data?.exams || []))
      .catch(() => {})
      .finally(() => setLoading(false));
  }, []);

  useEffect(() => {
    if (view === "taking" && activeExam && timeLeft > 0) {
      timerRef.current = setInterval(() => {
        setTimeLeft((t) => {
          if (t <= 1) {
            clearInterval(timerRef.current);
            handleSubmit();
            return 0;
          }
          return t - 1;
        });
      }, 1000);
    }
    return () => clearInterval(timerRef.current);
  }, [view, activeExam]);

  const generateExam = async () => {
    if (!genForm.subject) { toast.error("Subject domain required"); return; }
    setGenerating(true);
    try {
      const r = await examApi.generate(genForm);
      const exam = (r.data as any).data?.exam;
      setExams((prev) => [exam, ...prev]);
      toast.success("AI Exam logic synthesized.");
      setView("list");
    } catch {
      toast.error("Protocol failed. Verify AI credits.");
    } finally {
      setGenerating(false);
    }
  };

  const startExam = async (exam: ExamSession) => {
    try {
      const r = await examApi.start(exam._id);
      const started = (r.data as any).data?.exam || exam;
      setActiveExam(started);
      setAnswers({});
      setQIndex(0);
      setTimeLeft((started.timeLimitMinutes || 180) * 60);
      setView("taking");
    } catch {
      toast.error("Initialization failed");
    }
  };

  const handleSubmit = async () => {
    if (!activeExam) return;
    clearInterval(timerRef.current);
    const answerList = activeExam.questions.map(q => ({
      questionId: q._id,
      questionText: q.text,
      type: q.type,
      userAnswer: answers[q._id] || "",
      timeTaken: 0,
    }));
    try {
      const r = await examApi.submit(activeExam._id, answerList);
      setResults((r.data as any).data);
      setExams(prev => prev.map(e => e._id === activeExam._id ? { ...e, status: "graded", percentage: (r.data as any).data?.exam?.percentage } : e));
      setView("results");
    } catch {
      toast.error("Submission uplink failed");
    }
  };

  const formatTime = (s: number) => {
    const h = Math.floor(s / 3600);
    const m = Math.floor((s % 3600) / 60);
    const sec = s % 60;
    return `${h > 0 ? h + ':' : ''}${m.toString().padStart(2, '0')}:${sec.toString().padStart(2, '0')}`;
  };

  const gradeColor: Record<string, string> = {
    A: "var(--color-secondary)",
    B: "var(--color-primary)",
    C: "var(--color-secondary-light)",
    D: "var(--color-accent)",
    E: "var(--color-accent)",
    U: "var(--danger)",
  };

  if (loading) return <div className="flex items-center justify-center min-h-[70vh]"><Spinner size={40} className="text-primary" /></div>;

  return (
    <div className="max-w-6xl mx-auto space-y-8 animate-fade-in pb-12">
      {view !== "taking" && view !== "results" && (
        <div className="flex flex-col md:flex-row md:items-end justify-between gap-6">
          <div>
            <h2 className="text-3xl font-bold font-serif text-ink mb-2">AI Exam Simulator</h2>
            <p className="text-sm text-ink3 font-medium">Full timed sessions in official ZIMSEC format</p>
          </div>
          <Button onClick={() => setView("generate")} className="gap-2 shadow-lg">
            <Plus size={18} /> Initialize New Exam
          </Button>
        </div>
      )}

      {/* VIEW: LIST */}
      {view === "list" && (
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {exams.length === 0 ? (
            <div className="col-span-full">
              <EmptyState 
                icon={<ClipboardList size={40} />} 
                title="No simulated exams" 
                description="Generate a custom exam based on your curriculum level and subjects."
                action={<Button onClick={() => setView("generate")}>Generate First Exam</Button>}
              />
            </div>
          ) : (
            exams.map((e) => (
              <Card key={e._id} hoverable className="group flex flex-col h-full border-border2">
                <div className="flex justify-between items-start mb-6">
                  <div className="p-3 rounded-2xl bg-primary/5 text-primary group-hover:scale-110 transition-transform">
                    <History size={20} />
                  </div>
                  <Badge variant={e.status === 'graded' ? 'teal' : e.status === 'in_progress' ? 'amber' : 'blue'}>
                    {e.status.replace('_', ' ')}
                  </Badge>
                </div>
                
                <div className="flex-1">
                  <h3 className="text-lg font-bold text-ink mb-1 group-hover:text-primary transition-colors line-clamp-1">{e.title}</h3>
                  <div className="flex flex-wrap gap-x-4 gap-y-2 mb-6">
                    <p className="text-[10px] font-black text-ink3 uppercase tracking-widest flex items-center gap-1.5"><Target size={12} /> {e.subject}</p>
                    <p className="text-[10px] font-black text-ink3 uppercase tracking-widest flex items-center gap-1.5"><Timer size={12} /> {e.timeLimitMinutes}m</p>
                  </div>

                  {e.status === "graded" && e.percentage !== undefined && (
                    <div className="space-y-3 p-4 bg-bg rounded-2xl border border-border2">
                      <div className="flex justify-between items-end">
                        <span className="text-[10px] font-black text-ink3 uppercase tracking-widest">Achieved Grade</span>
                        <span className="text-xl font-black" style={{ color: gradeColor[e.grade || 'U'] }}>{e.grade}</span>
                      </div>
                      <ProgressBar value={e.percentage} className="!gap-0" color={gradeColor[e.grade || 'U']} />
                    </div>
                  )}
                </div>

                <div className="mt-8 flex gap-2">
                  {e.status !== "graded" ? (
                    <Button className="flex-1 shadow-md" onClick={() => startExam(e)}>
                      {e.status === "in_progress" ? "Resume Protocol" : "Launch Exam"}
                    </Button>
                  ) : (
                    <Button variant="outline" className="flex-1" onClick={() => { setActiveExam(e); setResults({ exam: e }); setView("results"); }}>
                      Review Analytics
                    </Button>
                  )}
                </div>
              </Card>
            ))
          )}
        </div>
      )}

      {/* VIEW: GENERATE */}
      {view === "generate" && (
        <div className="max-w-2xl mx-auto">
          <Card className="relative overflow-hidden border-border2">
            <div className="absolute top-0 right-0 p-12 opacity-5 pointer-events-none">
              <Sparkles size={160} />
            </div>
            
            <div className="relative z-10">
              <div className="flex items-center gap-4 mb-8">
                <div className="w-14 h-14 rounded-2xl bg-primary text-white flex items-center justify-center shadow-2xl">
                  <BrainCircuit size={28} />
                </div>
                <div>
                  <h3 className="text-2xl font-black font-serif text-ink tracking-tight">Synthesize Exam</h3>
                  <p className="text-[10px] text-primary font-bold uppercase tracking-[0.2em]">ZIMSEC Core Calibration</p>
                </div>
              </div>

              <div className="space-y-6">
                <div>
                  <label className="text-[10px] font-black text-ink3 uppercase tracking-widest mb-2 block">Syllabus Domain</label>
                  <Input 
                    placeholder="e.g. Advanced Level Physics" 
                    value={genForm.subject} 
                    onChange={(e) => setGenForm({...genForm, subject: e.target.value})} 
                  />
                </div>

                <div className="grid grid-cols-2 gap-4">
                  <div className="space-y-1.5">
                    <label className="text-[10px] font-black text-ink3 uppercase tracking-widest px-1">Curriculum Year</label>
                    <Input value={genForm.year} onChange={(e) => setGenForm({...genForm, year: e.target.value})} />
                  </div>
                  <div className="space-y-1.5">
                    <label className="text-[10px] font-black text-ink3 uppercase tracking-widest px-1">Examination Paper</label>
                    <select 
                      className="input text-sm font-bold bg-bg" 
                      value={genForm.paper} 
                      onChange={(e) => setGenForm({...genForm, paper: e.target.value})}
                    >
                      <option>Paper 1</option><option>Paper 2</option><option>Paper 3</option>
                    </select>
                  </div>
                </div>

                <div className="pt-4">
                  <div className="flex justify-between items-center mb-2">
                    <label className="text-[10px] font-black text-ink3 uppercase tracking-widest px-1">Mark Capacity</label>
                    <span className="text-sm font-bold text-primary">{genForm.totalMarks} Points</span>
                  </div>
                  <input
                    type="range" min={40} max={200} step={10}
                    className="w-full h-2 bg-surface2 rounded-lg appearance-none cursor-pointer accent-primary"
                    value={genForm.totalMarks}
                    onChange={(e) => setGenForm({...genForm, totalMarks: +e.target.value})}
                  />
                </div>

                <div className="pt-8 border-t border-border2 flex flex-col sm:flex-row gap-4">
                  <Button size="lg" className="flex-1 shadow-2xl h-14 text-base gap-3" onClick={generateExam} loading={generating}>
                    {!generating && <Zap size={20} />} Execute Generation
                  </Button>
                  <Button variant="ghost" size="lg" className="h-14" onClick={() => setView("list")}>Cancel</Button>
                </div>
              </div>
            </div>
          </Card>
        </div>
      )}

      {/* VIEW: TAKING */}
      {view === "taking" && activeExam && currentQ && (
        <div className="max-w-4xl mx-auto space-y-6">
          {/* HUD Overlay */}
          <Card className="sticky top-20 z-30 p-4 border-primary/20 backdrop-blur-md bg-surface/90 shadow-2xl flex items-center justify-between">
            <div className="flex items-center gap-6">
              <div className="flex items-center gap-3">
                <div className="w-10 h-10 rounded-xl bg-primary/10 text-primary flex items-center justify-center shadow-inner">
                  <ClipboardList size={20} />
                </div>
                <div className="hidden sm:block">
                  <p className="text-[10px] font-black text-ink3 uppercase tracking-widest mb-0.5">Exam Session</p>
                  <p className="text-xs font-bold text-ink truncate max-w-[200px]">{activeExam.title}</p>
                </div>
              </div>
              <div className="h-8 w-px bg-border2 hidden sm:block" />
              <div className="flex flex-col">
                <p className="text-[10px] font-black text-ink3 uppercase tracking-widest mb-0.5">Index</p>
                <p className="text-xs font-bold text-ink">Q {qIndex + 1} of {activeExam.questions.length}</p>
              </div>
            </div>

            <div className="flex items-center gap-4">
               <div className={clsx(
                 "flex items-center gap-2 px-4 py-2 rounded-xl border-2 transition-colors",
                 timeLeft < 300 ? "border-red-500 bg-red-500/10 text-red-500 animate-pulse" : "border-border2 bg-bg text-ink"
               )}>
                 <Timer size={18} />
                 <span className="text-lg font-black font-mono tracking-tighter">{formatTime(timeLeft)}</span>
               </div>
               <Button variant="danger" size="sm" className="hidden sm:flex" onClick={handleSubmit}>Terminate & Submit</Button>
            </div>
          </Card>

          <ProgressBar value={((activeExam.timeLimitMinutes * 60 - timeLeft) / (activeExam.timeLimitMinutes * 60)) * 100} className="!gap-1 h-1.5" color={timeLeft < 300 ? 'var(--danger)' : 'var(--color-primary)'} />

          <div className="grid grid-cols-1 lg:grid-cols-[1fr_280px] gap-6 items-start">
            <div className="space-y-6">
               <Card className="p-10 shadow-soft">
                  <div className="flex justify-between items-center mb-10">
                    <Badge variant={currentQ.type === 'essay' ? 'purple' : currentQ.type === 'mcq' ? 'blue' : 'amber'} className="px-4 py-1.5 text-[10px] font-black tracking-widest">
                      {currentQ.type.toUpperCase().replace('_', ' ')}
                    </Badge>
                    <span className="text-sm font-black text-ink3 uppercase tracking-[0.2em]">{currentQ.marks} MARKS</span>
                  </div>

                  <p className="text-2xl font-bold font-serif text-ink leading-relaxed mb-12">
                    {currentQ.text}
                  </p>

                  <div className="space-y-4">
                    {currentQ.type === 'mcq' ? (
                      <div className="grid grid-cols-1 gap-3">
                        {currentQ.options?.map((opt, i) => (
                          <button
                            key={i}
                            onClick={() => setAnswers({...answers, [currentQ._id]: opt})}
                            className={clsx(
                              "w-full text-left p-6 rounded-2xl border-2 transition-all duration-300 font-bold text-sm flex items-center justify-between group",
                              answers[currentQ._id] === opt ? "bg-primary/10 border-primary text-primary shadow-xl" : "bg-bg border-border2 text-ink2 hover:border-primary/40 hover:bg-surface2"
                            )}
                          >
                            <span>{opt}</span>
                            <div className={clsx("w-6 h-6 rounded-full border-2 flex items-center justify-center transition-all", answers[currentQ._id] === opt ? "bg-primary border-primary text-white" : "border-border2")}>
                              {answers[currentQ._id] === opt && <CheckCircle2 size={14} />}
                            </div>
                          </button>
                        ))}
                      </div>
                    ) : (
                      <textarea
                        className="w-full bg-bg border-2 border-border2 rounded-2xl p-8 text-lg font-medium focus:ring-8 focus:ring-primary/5 focus:border-primary outline-none transition-all shadow-inner min-h-[350px] leading-loose"
                        placeholder={currentQ.type === 'essay' ? "Synthesize your academic response here..." : "Provide precise analytical response..."}
                        value={answers[currentQ._id] || ""}
                        onChange={(e) => setAnswers({...answers, [currentQ._id]: e.target.value})}
                      />
                    )}
                  </div>

                  <div className="mt-12 pt-8 border-t border-border2 flex justify-between">
                    <Button variant="ghost" disabled={qIndex === 0} onClick={() => setQIndex(qIndex - 1)} className="gap-2">
                      <ChevronRight size={18} className="rotate-180" /> Previous Question
                    </Button>
                    {qIndex < activeExam.questions.length - 1 ? (
                      <Button onClick={() => setQIndex(qIndex + 1)} className="gap-2 px-8">
                        Next Challenge <ChevronRight size={18} />
                      </Button>
                    ) : (
                      <Button variant="secondary" onClick={handleSubmit} className="px-10 shadow-2xl">Finalize Exam Protocol</Button>
                    )}
                  </div>
               </Card>
            </div>

            {/* Navigation Grid Sidebar */}
            <aside className="space-y-6 sticky top-44">
               <Card className="p-6">
                  <h4 className="text-[10px] font-black text-ink3 uppercase tracking-[0.2em] mb-6 border-b border-border2 pb-4">Navigator Matrix</h4>
                  <div className="grid grid-cols-5 gap-2">
                    {activeExam.questions.map((q, i) => (
                      <button
                        key={i}
                        onClick={() => setQIndex(i)}
                        className={clsx(
                          "w-10 h-10 rounded-xl text-xs font-black transition-all flex items-center justify-center border-2",
                          i === qIndex ? "bg-primary text-white border-primary shadow-lg scale-110" : 
                          answers[q._id] ? "bg-secondary/10 text-secondary border-secondary/20" : "bg-bg text-ink3 border-border2 hover:border-primary/30"
                        )}
                      >
                        {i + 1}
                      </button>
                    ))}
                  </div>
               </Card>
               
               <Card className="bg-warn/5 border-warn/10 p-6">
                  <div className="flex items-center gap-3 mb-4">
                    <AlertTriangle size={18} className="text-warn" />
                    <h4 className="text-[10px] font-black text-warn uppercase tracking-widest">Protocol Warning</h4>
                  </div>
                  <p className="text-[11px] font-bold text-ink2 leading-relaxed">
                    Exiting this interface will result in a suspension of the timer. Frequent interruptions may degrade AI diagnostic accuracy.
                  </p>
               </Card>
            </aside>
          </div>
        </div>
      )}

      {/* VIEW: RESULTS */}
      {view === "results" && results?.exam && (
        <div className="max-w-4xl mx-auto space-y-6 animate-in zoom-in-95 duration-500">
           <Card className="p-12 text-center shadow-2xl relative overflow-hidden">
              <div className="absolute inset-0 bg-gradient-to-b from-primary/[0.03] to-transparent" />
              
              <div className="relative z-10">
                <div className="w-32 h-32 rounded-[2.5rem] bg-surface2 border border-border2 mx-auto flex items-center justify-center mb-8 shadow-inner">
                   <div className="text-6xl font-black font-serif" style={{ color: gradeColor[results.exam.grade] }}>{results.exam.grade}</div>
                </div>
                
                <h3 className="text-5xl font-black font-serif text-ink mb-2 tracking-tight">{results.exam.percentage}%</h3>
                <p className="text-xs font-black text-ink3 uppercase tracking-[0.3em] mb-12">Grade Certification Issued</p>
                
                <div className="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-2xl mx-auto mb-12">
                   <div className="p-6 rounded-3xl bg-bg border border-border2 shadow-soft">
                      <p className="text-[10px] font-black text-ink3 uppercase tracking-widest mb-1">Score Matrix</p>
                      <p className="text-2xl font-bold text-ink">{results.exam.earnedMarks} / {results.exam.totalMarks}</p>
                   </div>
                   <div className="p-6 rounded-3xl bg-bg border border-border2 shadow-soft">
                      <p className="text-[10px] font-black text-ink3 uppercase tracking-widest mb-1">XP Relayed</p>
                      <p className="text-2xl font-bold text-primary">+{results.xpEarned || 250}</p>
                   </div>
                   <div className="p-6 rounded-3xl bg-bg border border-border2 shadow-soft">
                      <p className="text-[10px] font-black text-ink3 uppercase tracking-widest mb-1">Accuracy</p>
                      <p className="text-2xl font-bold text-secondary">High</p>
                   </div>
                </div>
              </div>
           </Card>

           <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
              {results.exam.aiFeedback && (
                <Card className="bg-primary/[0.02] border-primary/10 p-10">
                   <div className="flex items-center gap-3 mb-6">
                     <div className="p-2 rounded-xl bg-primary text-white shadow-lg"><BrainCircuit size={18} /></div>
                     <h4 className="text-[10px] font-black text-primary uppercase tracking-[0.2em]">AI Examiner Feedback</h4>
                   </div>
                   <p className="text-lg font-serif italic text-ink leading-relaxed">"{results.exam.aiFeedback}"</p>
                </Card>
              )}

              {results.exam.weakTopics?.length > 0 && (
                <Card className="p-10">
                   <div className="flex items-center gap-3 mb-8">
                     <div className="p-2 rounded-xl bg-accent/10 text-accent"><Target size={18} /></div>
                     <h4 className="text-[10px] font-black text-accent uppercase tracking-[0.2em]">Deficit Identification</h4>
                   </div>
                   <div className="flex flex-wrap gap-2">
                     {results.exam.weakTopics.map((t: string) => (
                       <Badge key={t} variant="amber" className="px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest border border-warn/20">{t}</Badge>
                     ))}
                   </div>
                   <Button variant="ghost" className="w-full mt-10 border-t border-border2 rounded-none pt-6 text-primary font-black uppercase tracking-widest text-[10px] gap-2">
                     Synthesize Study Path <ArrowRight size={14} />
                   </Button>
                </Card>
              )}
           </div>

           <div className="flex justify-center gap-4 pt-8">
              <Button size="lg" className="px-12 shadow-2xl h-14" onClick={() => setView("list")}>Archive Result</Button>
              <Button variant="outline" size="lg" className="px-12 h-14" onClick={() => setView("generate")}>Initialize New Session</Button>
           </div>
        </div>
      )}
    </div>
  );
};

